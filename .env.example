# ── HeyVanilla environment variables ─────────────────────────────────────────
# Copy to `.env.local` for `npm run dev` (and to `.env` for docker compose).
# Anything WITHOUT the NEXT_PUBLIC_ prefix is server-only.

# Required — Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — Spotify "now playing" widget (Authorization Code + PKCE, no secret).
# Register the redirect URI in your Spotify app dashboard.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://localhost:3000/

# Optional — TMDB posters for the media library (server-side only)
TMDB_API_KEY=your-tmdb-key

# Weather uses Open-Meteo and needs no key.
